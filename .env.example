# ─────────────────────────────────────────────────────────────
#  Mitra hub configuration — copy to .env and fill in what you use.
#  Every key is optional: missing keys are reported as "not configured"
#  in the Parent Dashboard instead of crashing. Restart
#  `python mitra_server.py` after editing.
# ─────────────────────────────────────────────────────────────

# Groq LLM (child conversation + Soft Tale bedtime stories)
GROQ_API_KEY=your_groq_api_key_here
# Optional overrides. The hub verifies every model with models.list() at start-up (and probes the
# vision model with a real image), falling back to an available model if these aren't offered.
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_VISION_MODEL=

# Twilio — real SMS and automated voice calls to the parent's phone
# https://console.twilio.com → Account SID / Auth Token, plus a Twilio phone number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

# ntfy — free instant mobile push (install the ntfy app, subscribe to your topic).
# The topic can also be set in the dashboard; choose something hard to guess.
NTFY_TOPIC=
# Optional: self-hosted server and/or access token
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Telegram — message from your own bot (@BotFather → token; send the bot a
# message, then read chat.id from https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP) — optional backup channel. Gmail: smtp.gmail.com, port 587, an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PARENT_EMAIL=

# All provider keys above can also be entered in the dashboard (Distress & Stress → Alert Channels);
# they are written here and applied without a restart — only from the hub computer itself unless:
# MITRA_ALLOW_LAN_ADMIN=1

# Optional: listen on a different port (default 5000)
# MITRA_PORT=5000
